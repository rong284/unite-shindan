  "formulaNotes": [
    {
      "item": "性格7軸",
      "formula": "30問すべてから0〜100化",
      "purpose": "表側では『様子を見る←→自分から動く』のような両端ラベルで表示。"
    },
    {
      "item": "7→15線形変換",
      "formula": "50 + TranslationScale×Σ(norm性格×係数)/Σ|係数|",
      "purpose": "基本となるプレイ傾向。"
    },
    {
      "item": "組み合わせ効果",
      "formula": "高い性格同士の積×InteractionBonus",
      "purpose": "『主導性もリスクも高い→切り込み型』のように、平均化されにくくする。"
    },
    {
      "item": "補助嗜好",
      "formula": "Q21〜Q30の一部を15軸へ弱く反映",
      "purpose": "直接ゲームの好みを聞きすぎず、性格推定を主役にする。"
    },
    {
      "item": "FightTempo",
      "formula": "0=瞬間決着 / 100=継続戦",
      "purpose": "BurstとSustainDPSを統合し、同じ意味の重複を削減。"
    },
    {
      "item": "SelfSufficiency",
      "formula": "0=味方との依存が大きい / 100=自己完結しやすい",
      "purpose": "サポートとアサシン等を分ける上で重要な新軸。"
    },
    {
      "item": "RawMatch",
      "formula": "AbsoluteScore＋ShapeScore＋SpecificityCorrection",
      "purpose": "15軸の近さと『高低の形』を評価。"
    },
    {
      "item": "Empirical Percentile",
      "formula": "20,000疑似回答で各プロファイルのRawMatch分布を作り、その中での位置を評価",
      "purpose": "『このポケモンにここまで合う人は珍しい』を比較可能にする。"
    },
    {
      "item": "DisplayScore",
      "formula": "MAX(DisplayMin, DisplayBase + DisplayRange×Percentile^DisplayPower)",
      "purpose": "中間値の75付近へ固まらず、刺さった時は90台まで伸びる表示用スコア。"
    },
    {
      "item": "RankScore",
      "formula": "PercentileWeight×Percentile×100 + 残り×RawMatch + RankBias",
      "purpose": "順位用。ポケモンごとの出やすさは小さなRankBiasだけで校正。"
    },
    {
      "item": "補助3軸",
      "formula": "FarmScaling / ObjectiveSecure / ScoringSide",
      "purpose": "パッチ影響を受けやすいためWeightを0.4〜0.45に抑える。"
    },
    {
      "item": "注意",
      "formula": "DisplayScoreは勝率・確率ではない",
      "purpose": "『相性 / 100』として表示する。"
    }
  ]
}
