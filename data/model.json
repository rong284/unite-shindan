  "formulaNotes": [
    {
      "item": "性格軸スコア",
      "formula": "50 + 50 × [Σ(回答正規化×Question Loading) / Σ|Loading|]",
      "purpose": "Q01〜Q20。Loadingを変えると自動的に性格軸が変わる。"
    },
    {
      "item": "性格の正規化",
      "formula": "(性格スコア - 50) / 50",
      "purpose": "0〜100を-1〜+1へ変換。"
    },
    {
      "item": "7→15翻訳",
      "formula": "50 + 50 × [Σ(正規化性格×翻訳係数) / Σ|翻訳係数|]",
      "purpose": "Model_Formula!B13:H27を変更して調整。"
    },
    {
      "item": "嗜好スコア",
      "formula": "50 + 50 × [Σ(回答正規化×Preference Loading) / Σ|Loading|]",
      "purpose": "Q21〜Q30から各ゲーム軸の直接嗜好を算出。"
    },
    {
      "item": "最終15軸",
      "formula": "Translated×(1-Blend) + Preference×Blend",
      "purpose": "Blendは軸別。初期値30%。"
    },
    {
      "item": "軸別誤差",
      "formula": "Weight × (Pokemon-Player)^2 × IF(Pokemon>Player,1+OverReqPenalty,1)",
      "purpose": "要求値がプレイヤーを上回る場合のみ非対称ペナルティ。Execution/Decisionを強め。"
    },
    {
      "item": "Weighted RMSE",
      "formula": "SQRT(Σ軸別誤差 / ΣWeight)",
      "purpose": "0なら完全一致。"
    },
    {
      "item": "MatchScore",
      "formula": "MAX(0, 100 - Weighted RMSE)",
      "purpose": "直感的な0〜100表示用。統計的な確率ではない。"
    }
  ]
}
